{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemetricstoolkit.local/scoring/schemas/scoring-profile.schema.json",
  "title": "CodeMetricsToolkit scoring profile",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "id", "version", "artifactContractVersion", "allowedAnalysisModes", "allowedTargetIdStabilities", "selectors", "primary", "operations" ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/nonBlankString" },
    "version": {
      "$ref": "#/$defs/threePartVersion"
    },
    "artifactContractVersion": { "const": "0.1.0" },
    "allowedAnalysisModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [ "syntax", "semantic", "partial_semantic" ] }
    },
    "allowedTargetIdStabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [ "semantic", "syntax_fallback", "line_fallback" ] }
    },
    "selectors": { "$ref": "#/$defs/selectors" },
    "primary": { "$ref": "#/$defs/primary" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/thresholdDebt" },
          { "$ref": "#/$defs/weightedSum" }
        ]
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "threePartVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Selectors apply to complete targets: every declaration path must match includeFilePaths and any excludeFilePaths match rejects the target. Non-empty path selectors require graph nodes with complete declaration paths; this is a stricter scoring precondition than the base 0.1.0 artifact schema.",
      "properties": {
        "includeFilePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "excludeFilePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "requireTrusted": { "type": "boolean", "default": true },
        "minTargetCount": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "key", "direction" ],
      "properties": {
        "key": { "$ref": "#/$defs/nonBlankString" },
        "direction": { "enum": [ "minimize", "maximize" ] }
      }
    },
    "metricThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "metricId", "metricVersion", "maximum" ],
      "properties": {
        "metricId": { "$ref": "#/$defs/nonBlankString" },
        "metricVersion": { "$ref": "#/$defs/threePartVersion" },
        "maximum": { "type": "number" },
        "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      }
    },
    "thresholdDebtOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "gapSum", "squaredGapSum", "violatingTargetCount", "maxTargetGap" ],
      "properties": {
        "gapSum": { "$ref": "#/$defs/nonBlankString" },
        "squaredGapSum": { "$ref": "#/$defs/nonBlankString" },
        "violatingTargetCount": { "$ref": "#/$defs/nonBlankString" },
        "maxTargetGap": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "thresholdDebt": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "operation", "targetKind", "thresholds", "outputs" ],
      "properties": {
        "operation": { "const": "thresholdDebt" },
        "targetKind": { "enum": [ "file", "type", "member" ] },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metricThreshold" }
        },
        "outputs": { "$ref": "#/$defs/thresholdDebtOutputs" }
      }
    },
    "weightedTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "key", "weight" ],
      "properties": {
        "key": { "$ref": "#/$defs/nonBlankString" },
        "weight": { "type": "number" }
      }
    },
    "weightedSum": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "operation", "terms", "output" ],
      "properties": {
        "operation": { "const": "weightedSum" },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/weightedTerm" }
        },
        "output": { "$ref": "#/$defs/nonBlankString" }
      }
    }
  }
}
