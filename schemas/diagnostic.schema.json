{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemetricstoolkit.local/schemas/diagnostic.schema.json",
  "title": "CodeMetricsToolkit diagnostic line",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "id", "severity", "message" ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "severity": { "enum": [ "info", "warning", "error", "critical" ] },
    "message": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string", "minLength": 1 },
    "filePath": { "type": "string", "minLength": 1 },
    "startLine": { "type": "integer", "minimum": 1 },
    "endLine": { "type": "integer", "minimum": 1 },
    "targetId": { "type": "string", "minLength": 1 },
    "targetKind": { "enum": [ "solution", "project", "file", "type", "member" ] },
    "metricId": { "type": "string", "minLength": 1 },
    "exceptionType": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
